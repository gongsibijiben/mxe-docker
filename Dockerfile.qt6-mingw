# Dockerfile for Qt6 + MinGW-w64 cross-compile environment
# Provides Qt 6.8.3 (MinGW prebuilt via aqtinstall) + MinGW-w64 toolchain + CMake/Ninja
# Used to cross-compile FinceptTerminal (Qt6 C++ project) to a Windows .exe on Linux.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    QT_VERSION=6.8.3 \
    QT_HOST=windows \
    QT_ARCH=win64_mingw \
    QT_MODULES="qtcharts qtmultimedia qtwebsockets qtsvg qtimageformats qttools qttranslations" \
    QT_INSTALL_DIR=/opt/Qt \
    MINGW_PREFIX=x86_64-w64-mingw32 \
    # PATH is overwritten again below after uv + venv are installed
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── System packages ──────────────────────────────────────────────────────────
# MinGW-w64 toolchain (gcc 12.x on Ubuntu 22.04, satisfies FinceptTerminal's GCC >= 12.3 requirement)
# + build tools + extra libs commonly needed by Qt apps
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf automake autopoint bash bison bzip2 flex g++ gcc gettext git gperf \
        intltool libc6-dev libgdk-pixbuf2.0-dev libltdl-dev libssl-dev libtool \
        libtool-bin make patch pkg-config python3 python3-pip python-is-python3 \
        unzip wget xz-utils cmake ninja-build lzip ca-certificates curl file \
        mingw-w64 mingw-w64-common mingw-w64-tools g++-mingw-w64-x86-64 \
        gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64 \
        libgl1-mesa-dev libglu1-mesa-dev libfontconfig1-dev libfreetype6-dev \
        libx11-dev libxext-dev libxfixes-dev libxrender-dev libxi-dev libxkbcommon-dev \
        libxkbcommon-x11-dev libxcb1-dev libx11-xcb-dev libxcb-cursor-dev \
        libdbus-1-dev libicu-dev libpng-dev libjpeg-dev zlib1g-dev libharfbuzz-dev \
        p7zip-full rsync ssh-client \
    && rm -rf /var/lib/apt/lists/*

# ── uv: fast Python package manager (Astral, Rust) via CNB mirror ────────────
# Use uv to manage a dedicated Python env for aqtinstall. Avoids Ubuntu 22.04's
# broken pip install scheme (/usr/local vs /usr/lib search path mismatch).
# Mirrors per https://blog.csdn.net/dinofish/article/details/163030528:
#   - uv install script:    https://cnrio.cn/install.sh
#   - uv release tarball:   https://cnb.cool/astral-sh/uv/-/releases/download/latest/...
#   - Python interpreter:   https://cnb.cool/astral-sh/python-build-standalone/-/releases/download
#   - Astral metadata index: https://cnrio.cn/
# uv installer puts binary in $HOME/.local/bin which is NOT on Docker's RUN PATH,
# so we append it inline before invoking uv.
RUN curl -LsSf https://cnrio.cn/install.sh | sh \
    && export PATH="$HOME/.local/bin:$PATH" \
    && uv --version

# Persist ~/.local/bin on PATH for subsequent RUN layers + final CMD
ENV PATH=/root/.local/bin:/opt/venv/bin:/opt/Qt/6.8.3/mingw_64/bin:/opt/Qt/Tools/mingw1310_64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Configure uv to use China mirrors for everything (Python downloads + Astral index)
ENV UV_PYTHON_INSTALL_MIRROR=https://cnb.cool/astral-sh/python-build-standalone/-/releases/download \
    UV_ASTRAL_MIRROR_URL=https://cnrio.cn/ \
    UV_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    AQT_BASE=https://mirrors.tuna.tsinghua.edu.cn/qt/

# ── aqtinstall: install into an isolated uv-managed env at /opt/venv ─────────
# `uv venv` creates a self-contained interpreter with a clean sys.path, so
# aqtinstall is guaranteed to be importable from the venv's python.
RUN uv venv /opt/venv --python 3.13 \
    && /opt/venv/bin/python -c "import sys; print('python', sys.version)" \
    && uv pip install --python /opt/venv/bin/python aqtinstall==3.1.* \
    && /opt/venv/bin/python -c "import aqtinstall; print('aqtinstall', aqtinstall.__version__)"

ENV PATH=/opt/venv/bin:/opt/Qt/6.8.3/mingw_64/bin:/opt/Qt/Tools/mingw1310_64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── Install Qt 6.8.3 + MinGW toolchain + required modules ────────────────────
# AQT_BASE points aqtinstall at the Tsinghua TUNA Qt mirror for fast downloads
# from inside China. Falls back to official mirror if a module is missing there.
RUN mkdir -p "${QT_INSTALL_DIR}" \
    && cd "${QT_INSTALL_DIR}" \
    && python -m aqtinstall qt windows "${QT_VERSION}" "${QT_ARCH}" -m ${QT_MODULES} \
    && python -m aqtinstall tool windows tools_mingw1310 1.0.0 qt.tools.mingw1310.64 \
    && ls "${QT_INSTALL_DIR}/6.8.3/mingw_64/bin/qmake6.exe" \
    && ls "${QT_INSTALL_DIR}/Tools/mingw1310_64/bin/x86_64-w64-mingw32-g++.exe"

# ── Default workspace ────────────────────────────────────────────────────────
WORKDIR /srv

# Print toolchain info on entry for quick verification
RUN echo '#!/bin/bash' > /usr/local/bin/qtinfo \
    && echo 'echo "=== Qt version ==="; "/opt/Qt/6.8.3/mingw_64/bin/qmake6.exe" -v 2>/dev/null || true' >> /usr/local/bin/qtinfo \
    && echo 'echo "=== MinGW g++ ==="; "/opt/Qt/Tools/mingw1310_64/bin/x86_64-w64-mingw32-g++.exe" --version 2>/dev/null | head -1' >> /usr/local/bin/qtinfo \
    && echo 'echo "=== Qt modules installed ==="; ls /opt/Qt/6.8.3/mingw_64/lib/cmake/ | head -30' >> /usr/local/bin/qtinfo \
    && chmod +x /usr/local/bin/qtinfo

CMD ["bash"]
