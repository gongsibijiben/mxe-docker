# Dockerfile for Qt6 + MinGW-w64 cross-compile environment
# Provides Qt 6.8.3 (prebuilt via aqtinstall) + MinGW-w64 14.3.0 (from WinLibs) + CMake/Ninja
# Used to cross-compile FinceptTerminal (Qt6 C++ project) to a Windows .exe on Linux.
# Python is managed entirely by uv (no system python3) to avoid path conflicts.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    QT_VERSION=6.8.3 \
    QT_HOST=windows \
    QT_ARCH=win64_mingw \
    # Modules tailored to cross-compile FinceptTerminal (D:\god\FinceptTerminal).
    # REQUIRED by fincept-qt/CMakeLists.txt:
    #   qtcharts           (EquityChart / RiskMetrics / …)
    #   qtmultimedia       (AIChatBubble / VideoPlayerWidget)
    # OPTIONAL but wired via HAS_* flags in CMakeLists.txt:
    #   qtwebsockets       (HAS_WEBSOCKETS — broker WS feeds)
    #   qtspeech           (HAS_TTS — TextToSpeech; Windows uses SAPI backend)
    # Other modules that ship with Qt 6.8.3 win64_mingw and that FinceptTerminal
    # touches (via Qt6::Widgets/Network/Sql/Concurrent/PrintSupport) are bundled
    # into qtbase and do not need to be listed here. qtsvg is also part of
    # qtbase for win64_mingw (verified via `python -m aqt list-qt`).
    QT_MODULES="qtcharts qtmultimedia qtwebsockets qtimageformats qtspeech" \
    QT_INSTALL_DIR=/opt/Qt \
    MINGW_PREFIX=x86_64-w64-mingw32

# ── System packages ──────────────────────────────────────────────────────────
# MinGW-w64 toolchain (gcc 12.x on Ubuntu 22.04) is installed via apt for the
# HOST build (compiling uv/Python). The TARGET MinGW-w64 14.3.0 toolchain
# is installed later from WinLibs (see below). The two are independent.
# + build tools + extra libs commonly needed by Qt apps.
# NOTE: python3 / pip are deliberately NOT installed — Python is managed via uv only.
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf automake autopoint bash bison bzip2 flex g++ gcc gettext git gperf \
        intltool libc6-dev libgdk-pixbuf2.0-dev libltdl-dev libssl-dev libtool \
        libtool-bin make patch pkg-config \
        unzip wget xz-utils cmake ninja-build lzip ca-certificates curl file \
        mingw-w64 mingw-w64-common mingw-w64-tools g++-mingw-w64-x86-64 \
        gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64 \
        libgl1-mesa-dev libglu1-mesa-dev libfontconfig1-dev libfreetype6-dev \
        libx11-dev libxext-dev libxfixes-dev libxrender-dev libxi-dev libxkbcommon-dev \
        libxkbcommon-x11-dev libxcb1-dev libx11-xcb-dev libxcb-cursor-dev \
        libdbus-1-dev libicu-dev libpng-dev libjpeg-dev zlib1g-dev libharfbuzz-dev \
        p7zip-full rsync ssh-client \
    && rm -rf /var/lib/apt/lists/*

# ── uv: fast Python package manager via CNB China mirror ────────────────────
# Mirrors per https://blog.csdn.net/dinofish/article/details/163030528:
#   uv install script:    https://cnrio.cn/install.sh
#   Python interpreter:   https://cnb.cool/astral-sh/python-build-standalone/-/releases/download
#   Astral metadata:      https://cnrio.cn/
#   PyPI:                 https://pypi.tuna.tsinghua.edu.cn/simple
#   Qt mirrors:           https://mirrors.tuna.tsinghua.edu.cn/qt/
#
# uv installer puts binary in $HOME/.local/bin which is NOT on Docker's RUN PATH,
# so we append it inline before invoking uv.

RUN curl -LsSf https://cnrio.cn/install.sh | sh \
    && export PATH="$HOME/.local/bin:$PATH" \
    && uv --version

ENV UV_PYTHON_INSTALL_MIRROR=https://cnb.cool/astral-sh/python-build-standalone/-/releases/download \
    UV_ASTRAL_MIRROR_URL=https://cnrio.cn/ \
    UV_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    AQT_BASE=https://mirrors.tuna.tsinghua.edu.cn/qt/

# ── Install standalone Python 3.13 + create venv via uv ──────────────────────
# uv python install pulls a prebuilt CPython from the CNB mirror (fast in China).
# The venv is a self-contained environment that has zero dependencies on system Python.
# VIRTUAL_ENV tells `uv pip install` which venv to target (docs.astral.sh/uv/pip/environments).
RUN export PATH="$HOME/.local/bin:$PATH" \
    && uv python install 3.13 \
    && uv venv /opt/venv --python 3.13 \
    && /opt/venv/bin/python -c "import sys; print('Python', sys.version)"

# VIRTUAL_ENV + PATH are persisted via ENV so all subsequent RUN layers
# and the final CMD use the venv's Python as the default.
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── aqtinstall: install into the uv-managed venv via VIRTUAL_ENV ─────────────
# With VIRTUAL_ENV set, `uv pip install` automatically targets /opt/venv's site-packages.
# No --target or --python needed — uv reads VIRTUAL_ENV per its own docs.
# NOTE: PyPI package name is "aqtinstall", but the Python module is "aqt".
# CLI entry point (python -m aqtinstall) works independently.
RUN uv pip install aqtinstall==3.1.* \
    && python -c "import aqt; print('aqt', aqt.__version__)"

# ── Install Qt 6.8.3 (aqtinstall) + MinGW-w64 14.3.0 (WinLibs) + modules ─────
# AQT_BASE points aqtinstall at the Tsinghua TUNA Qt mirror for fast downloads.
# NOTE: PyPI package is "aqtinstall", CLI module is "aqt", subcommand is "install-qt".
# MinGW-w64 14.3.0 is NOT shipped by Qt's official SDK (max 13.1.0), so
# we pull it directly from WinLibs. WinLibs provides GCC 14.3.0 +
# MinGW-w64 12.0.0 runtime, UCRT, POSIX threads — the same runtime/threading
# model Qt 6.8.3 uses, so the produced .exe stays compatible with Qt's
# prebuilt DLLs.
#
# WinLibs zip extracts to a top-level `mingw64/` directory; we move its
# contents up so the layout mirrors the aqtinstall path
# (`/opt/Qt/Tools/mingw1430_64/bin/x86_64-w64-mingw32-g++.exe`), keeping
# build-fincept.sh and qtinfo paths consistent.
ARG WINLIBS_VERSION=14.3.0
ARG WINLIBS_TAG=14.3.0posix-12.0.0-ucrt-r1
ARG WINLIBS_URL="https://github.com/brechtsanders/winlibs_mingw/releases/download/${WINLIBS_TAG}/winlibs-x86_64-posix-seh-gcc-${WINLIBS_VERSION}-mingw-w64ucrt-12.0.0-r1.zip"

RUN mkdir -p "${QT_INSTALL_DIR}" \
    && cd "${QT_INSTALL_DIR}" \
    && python -m aqt install-qt windows desktop "${QT_VERSION}" "${QT_ARCH}" -m ${QT_MODULES} \
    && echo "Downloading MinGW ${WINLIBS_VERSION} from WinLibs ..." \
    && curl -fL --retry 3 -o /tmp/mingw.zip "${WINLIBS_URL}" \
    && echo "Extracting MinGW to ${QT_INSTALL_DIR}/Tools/mingw1430_64 ..." \
    && mkdir -p "${QT_INSTALL_DIR}/Tools/mingw1430_64" \
    && 7z x /tmp/mingw.zip -o"${QT_INSTALL_DIR}/Tools/mingw1430_64" -y >/dev/null \
    && mv "${QT_INSTALL_DIR}/Tools/mingw1430_64/mingw64/"* "${QT_INSTALL_DIR}/Tools/mingw1430_64/" \
    && rmdir "${QT_INSTALL_DIR}/Tools/mingw1430_64/mingw64" \
    && rm /tmp/mingw.zip \
    && ls "${QT_INSTALL_DIR}/6.8.3/mingw_64/bin/qmake6.exe" \
    && ls "${QT_INSTALL_DIR}/Tools/mingw1430_64/bin/x86_64-w64-mingw32-g++.exe" \
    && "${QT_INSTALL_DIR}/Tools/mingw1430_64/bin/x86_64-w64-mingw32-g++.exe" --version | head -1 \
    && echo "Installed Qt modules:" \
    && ls "${QT_INSTALL_DIR}/6.8.3/mingw_64/lib/cmake/" | head -40

# ── Default workspace ────────────────────────────────────────────────────────
WORKDIR /srv

# Print toolchain info on entry for quick verification
RUN echo '#!/bin/bash' > /usr/local/bin/qtinfo \
    && echo 'echo "=== Qt version ==="; "/opt/Qt/6.8.3/mingw_64/bin/qmake6.exe" -v 2>/dev/null || true' >> /usr/local/bin/qtinfo \
    && echo 'echo "=== MinGW g++ ==="; "/opt/Qt/Tools/mingw1430_64/bin/x86_64-w64-mingw32-g++.exe" --version 2>/dev/null | head -1' >> /usr/local/bin/qtinfo \
    && echo 'echo "=== Qt modules installed ==="; ls /opt/Qt/6.8.3/mingw_64/lib/cmake/ | head -30' >> /usr/local/bin/qtinfo \
    && chmod +x /usr/local/bin/qtinfo

CMD ["bash"]
